# ! optional PostgreSQL development config
# cpy this file to .env

# the PostgreSQL database/user locally. change the sample credentials
DOSEARK_STORAGE=postgres
DATABASE_URL=postgres://doseark:CHANGE_ME@127.0.0.1:5432/doseark
DOSEARK_API_BIND=127.0.0.1:8080

# for local development only
DOSEARK_RUNTIME_SETTINGS_PATH=./data/runtime-settings.json
DOSEARK_MAX_BACKUP_DOWNLOAD_BYTES=268435456
RUST_LOG=warn,doseark_api=info,doseark_db_postgres=info,sqlx=warn
