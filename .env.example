# DoseArk local development — copy to .env (do not commit .env).
# Run both pnpm dev:api and pnpm dev:web from the repository root.
DOSEARK_STORAGE=sqlite
DOSEARK_SQLITE_PATH=./data/doseark.sqlite
DOSEARK_API_BIND=127.0.0.1:8080

# Debug logging. Runtime logging settings can be changed in the application.
RUST_LOG=warn,doseark_api=debug,doseark_db_sqlite=debug,tower_http=info,sqlx=warn
DOSEARK_LOG_CONSOLE_TARGET=false
DOSEARK_RUNTIME_SETTINGS_PATH=./data/runtime-settings.json

# SQLite backups default to ./data/backups/; uncomment to override.
# DOSEARK_BACKUP_DIR=./data/backups
DOSEARK_MAX_BACKUP_DOWNLOAD_BYTES=268435456

# Optional local diagnostic profile; the API uses DOSEARK_STORAGE and other env values.
DOSEARK_PROFILES_FILE=./config/profiles.json
# Optional, local-only credentials references for profile validation:
# DOSEARK_CREDENTIALS_FILE=./config/credentials.local.json

# Optional database connection tuning
# DOSEARK_DB_CONNECT_ATTEMPTS=3
# DOSEARK_DB_CONNECT_TIMEOUT_MS=5000
# DOSEARK_DB_RETRY_DELAY_MS=1500
# DOSEARK_DB_MAX_CONNECTIONS=10
