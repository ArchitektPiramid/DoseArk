{
  "name": "@doseark/web",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -p tsconfig.app.json --noEmit --noUnusedLocals --noUnusedParameters --pretty false && tsc -p tsconfig.node.json --noEmit --noUnusedLocals --noUnusedParameters --pretty false"
  },
  "dependencies": {
    "@doseark/client": "workspace:*",
    "@doseark/types": "workspace:*",
    "@unocss/reset": "66.7.0",
    "echarts": "6.1.0",
    "healthicons-react": "3.5.0",
    "i18next": "26.7.2",
    "lucide-react": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.1.13",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "unocss": "66.7.2",
    "vite": "8.3.3"
  }
}
